{
  "name": "agent-peers-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p adapters/tsconfig.json && tsc --noEmit -p test/e2e/tsconfig.json",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:live": "AGENT_PEERS_LIVE=1 bun test test/live",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run lint && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
