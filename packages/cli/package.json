{
  "name": "@agent-peers/cli-app",
  "version": "0.1.0",
  "description": "agent-peers CLI source: compiled into the agent-peers binary (published via the @agent-peers/cli launcher, see npm/)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonacy/agent-peers.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "embed": "bun scripts/embed-adapters.ts",
    "build": "bun scripts/release.ts --current --outfile dist/agent-peers"
  },
  "dependencies": {
    "@agent-peers/protocol": "workspace:*",
    "@agent-peers/core": "workspace:*",
    "@agent-peers/hub": "workspace:*",
    "@agent-peers/bridge": "workspace:*",
    "commander": "^15.0.0",
    "@clack/prompts": "^1.8.1",
    "@vercel/detect-agent": "^1.2.6",
    "smol-toml": "^1.9.1",
    "jsonc-parser": "^3.3.1"
  },
  "bin": {
    "agent-peers": "./dist/agent-peers"
  },
  "private": true
}
